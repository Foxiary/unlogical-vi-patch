# Unity asset bundles and game data are binary — never diff or normalise them
romfs/** binary
*.assets binary
*.resS   binary
*.dat    binary

# The code patch is 19 bytes of machine code; an EOL conversion would corrupt it silently
exefs/** binary
*.ips    binary
*.png    binary

# Text files in the repo keep LF
*.md   text eol=lf
*.json text eol=lf
*.py   text eol=lf

# The e2e harness is Windows-only (Ryujinx + Win32 input); keep CRLF on checkout
*.ps1  text eol=crlf
